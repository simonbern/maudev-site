---
import { getImage } from 'astro:assets';
import { slugVille } from '../format';
import { localize, type Locale } from '../i18n';

/**
 * Où MauDev bâtit — un index cliquable.
 *
 * Remplace les trois piliers numérotés qui fermaient la section « Notre
 * modèle » de l'accueil. Ils disaient exactement ce que `/notre-modele` dit
 * en entier, dans les mêmes mots, à un clic de distance : une page d'accueil
 * qui résume la page suivante retarde le clic sans rien ajouter.
 *
 * Ce bloc dit quelque chose que l'accueil ne disait nulle part : **où**. Les
 * villes viennent de la collection — ajouter un projet change la liste sans
 * que personne édite un fichier de contenu.
 *
 * **Chaque ligne est un lien**, vers son groupe sur `/projets`. Elle ne l'a
 * pas toujours été, et une liste qui a l'air d'un menu sans en être un est
 * pire qu'une liste sobre : on essaie de cliquer, il ne se passe rien.
 *
 * **Le nombre de projets livrés ne s'affiche plus.** Il l'a fait, aligné à
 * droite. La section répond à « où », pas à « combien », et le chiffre était
 * déjà deux fois sur le chemin : dans « MauDev en chiffres » juste après, et
 * en tête de chaque groupe de `/projets`, où le lien mène. Il sert encore à
 * **trier** — les municipalités les plus fournies d'abord — mais il ne se lit
 * plus.
 *
 * **Aucun filet, aucune bordure.** La première version en avait neuf : une
 * bordure au-dessus de chaque ligne, une sous la dernière, et un filet de
 * liaison au milieu de chacune. Ça venait d'une table des matières, où le
 * filet sert à traverser un grand vide entre un titre à gauche et un numéro
 * de page à droite. Ici il n'y a pas de vide à traverser : la flèche suit le
 * nom sur la même ligne, à une chasse de distance.
 *
 * Ce qui sépare les entrées est donc l'espace, et rien d'autre — quatre lignes
 * de texte alignées à gauche, drapeau à droite. C'est aussi ce qui évite la
 * grande zone vide à droite des noms courts : « Huntingdon » ne tire plus un
 * trait sur 900 px pour rejoindre son chiffre.
 *
 * Le nom est en serif d'affichage. C'est la deuxième fois seulement que cette
 * famille apparaît (l'autre est le titre du hero) : elle est réservée à ce qui
 * se lit comme un titre et non comme une donnée.
 *
 * **Le titre de section est deux fois plus grand que les noms.** Il a été à
 * leur taille exacte — `text-h2` des deux côtés : le changement de famille ne
 * suffisait pas à dire lequel des deux était le titre, et la section se lisait
 * comme cinq entrées dont la première était bizarre. Le titre est donc passé
 * en `text-display`, la taille des trois autres titres de section de
 * l'accueil, qu'il n'aurait jamais dû quitter.
 *
 * **Une carte a été essayée puis retirée** — quatre pastilles vertes posées sur
 * les vraies coordonnées, avec les plans d'eau de la région tirés
 * d'OpenStreetMap en fond. Elle marchait, et elle n'a pas convaincu. Sont
 * partis avec elle `src/geo.ts`, `src/villes.ts` et `scripts/carte/`.
 *
 * Aucune boîte, aucune photo. Elle vient juste après « À venir », avec qui
 * elle partage son fond vert clair, et juste avant la photo d'intérieur.
 */
interface Props {
  titre: string;
  /** Déjà triées et comptées par l'appelant. `projets` = livrés. */
  villes: { nom: string; projets: number }[];
  locale: Locale;
  /**
   * Survols aériens, un par ville, sous la liste. La liste nomme les villes,
   * les vidéos les montrent avec les projets épinglés. Chaque légende mène au
   * même groupe de `/projets` que la ligne correspondante.
   */
  survols?: { ville: string; mp4: string; poster: ImageMetadata }[];
  survolLabel?: (ville: string) => string;
  playLabel?: string;
  pauseLabel?: string;
  survolsTitre?: string;
}
const {
  titre,
  villes,
  locale,
  survols = [],
  survolLabel = (v: string) => v,
  playLabel = 'Play',
  pauseLabel = 'Pause',
  survolsTitre,
} = Astro.props;

// `poster` veut une URL, pas un composant <Image>.
const posters = await Promise.all(
  survols.map(async (s) => (await getImage({ src: s.poster, width: 1920, format: 'webp' })).src),
);

const projetsUrl = localize('/projets', locale);
---

{/* Le vert clair de l'accueil. Il tient sur deux sections et non plus une :
    « À venir » l'a rejointe au-dessus (voir `Landing.astro`), et les deux
    forment maintenant un seul champ clair entre le carrousel des projets à
    louer et « Une seule plateforme intégrée », tous deux sombres.

    C'est ce contraste qui donne son rôle au bloc — une respiration colorée au
    milieu de la page, là où le propos passe de ce qui se loue aujourd'hui à ce
    qui n'existe pas encore. `section-alt` l'en séparait à peine.

    Le vert part du #789C9A du client, dilué puis poussé vers le vert : assez teinté
    pour se lire comme un vert, assez pâle pour porter le texte courant. */}
<section class="zone-claire bg-section-accent py-14 md:py-16 lg:py-20">
  <div class="mx-auto max-w-page px-5 md:px-8 lg:px-12">
    {/* `text-display`, comme les trois autres titres de section de l'accueil.
        Il était en `text-h2` — exactement la taille des noms de ville en
        dessous : deux niveaux de lecture à la même taille, et le titre ne se
        lisait plus comme un titre. Il est maintenant deux fois plus grand
        qu'eux, et dans l'autre famille. */}
    <h2 data-reveal class="max-w-narrow text-display text-balance text-ink">{titre}</h2>

    <ol class="mt-12 flex flex-col gap-6 md:mt-16 md:gap-8">
      {
        villes.map((v, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}>
            {/* `w-fit` : la zone cliquable épouse le texte. Sur toute la
                largeur, survoler le vide à droite d'« Huntingdon » allumait
                la ligne, ce qui promet un lien là où il n'y a rien à lire. */}
            <a
              href={`${projetsUrl}#ville-${slugVille(v.nom)}`}
              class="group flex w-fit max-w-full cursor-pointer flex-wrap items-baseline gap-x-5 gap-y-1 rounded-card"
            >
              <span class="font-display text-h2 text-balance text-ink transition-colors duration-500 group-hover:text-accent-ink">
                {v.nom}
              </span>

              {/* Le décompte de projets livrés a été retiré : la section
                  répond à « où », pas à « combien », et le chiffre est déjà
                  deux fois sur la page — dans « MauDev en chiffres » et en
                  tête de chaque groupe de `/projets`, où le lien mène. */}
              <span class="flex items-center text-ink-muted transition-colors duration-500 group-hover:text-accent-ink">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5 shrink-0 transition-transform duration-500 ease-[var(--ease-doux)] group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    {/* ── Survols. Un seul lecteur à la largeur de la colonne, qui enchaîne
        les villes, plutôt que deux vignettes côte à côte. À 1 280 px, deux
        vidéos faisaient 576 px chacune, trop peu pour lire les étiquettes
        incrustées. Sorties de la grille, elles étaient lisibles mais
        cassaient l'alignement de la page. Empilées, elles en faisaient deux
        écrans pleins.

        Les noms de ville au-dessus servent d'onglets. Le filet qui se remplit
        sous chacun dit ce qui joue et ce qui vient. Au bout d'un clip, le
        suivant prend le relais, en fondu. */}
    {
      survols.length > 0 && (
        <div data-survols class="mt-16 md:mt-24" data-reveal>
          {/* Sous-titre de section : `text-h1` sans serif, un cran sous le
              titre de la section et dans l'autre famille que les noms de
              ville, pour ne se confondre avec aucun des deux. */}
          {survolsTitre && (
            <h3 class="mb-10 text-h1 text-balance text-ink md:mb-12">{survolsTitre}</h3>
          )}
          <div class="grid gap-4 md:gap-6" style={`grid-template-columns:repeat(${survols.length},minmax(0,1fr))`}>
            {survols.map((s, i) => (
              <button
                type="button"
                data-survol-tab
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`survol-${i}`}
                class="group cursor-pointer rounded-card text-left"
              >
                <span class="block h-0.5 overflow-hidden rounded-full bg-ink/15">
                  <span data-progress class="block h-full w-0 bg-accent-ink" />
                </span>
                <span class="mt-3 block font-display text-h3 text-ink-muted transition-colors duration-500 group-hover:text-ink group-aria-pressed:text-ink">
                  {s.ville}
                </span>
              </button>
            ))}
          </div>

          <div class="relative mt-5 aspect-video overflow-hidden rounded-card bg-inverse">
            {survols.map((s, i) => (
              <video
                id={`survol-${i}`}
                data-actif={i === 0 ? '' : undefined}
                aria-hidden={i === 0 ? 'false' : 'true'}
                aria-label={survolLabel(s.ville)}
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 data-[actif]:opacity-100 motion-reduce:transition-none"
                src={s.mp4}
                poster={posters[i]}
                muted
                playsinline
                preload={i === 0 ? 'metadata' : 'none'}
              />
            ))}

            {/* Le lecteur démarre seul : il lui faut une pause au clavier
                (WCAG 2.2.2). Même bouton que le hero. */}
            <button
              type="button"
              data-survol-toggle
              data-play-label={playLabel}
              data-pause-label={pauseLabel}
              aria-label={playLabel}
              class="absolute right-4 bottom-4 inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-card bg-scrim/60 text-on-inverse backdrop-blur-sm transition-colors duration-200 hover:bg-scrim/80"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="hidden h-5 w-5" aria-hidden="true" data-icon-pause>
                <rect x="7" y="5" width="3.5" height="14" rx="1" />
                <rect x="13.5" y="5" width="3.5" height="14" rx="1" />
              </svg>
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true" data-icon-play>
                <path d="M8 5.5v13l11-6.5z" />
              </svg>
            </button>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-survols]');
  if (root) {
    const vids = [...root.querySelectorAll('video')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-survol-tab]')];
    const bars = tabs.map((t) => t.querySelector<HTMLElement>('[data-progress]')!);
    const toggle = root.querySelector<HTMLButtonElement>('[data-survol-toggle]')!;
    const iconPause = toggle.querySelector('[data-icon-pause]')!;
    const iconPlay = toggle.querySelector('[data-icon-play]')!;

    let actif = 0;
    let visible = false;
    // En mouvement réduit, rien ne démarre seul : le poster reste, le bouton
    // et les onglets lancent la lecture à la demande.
    let arrete = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sync = () => {
      const v = vids[actif];
      const joue = visible && !arrete;
      if (joue) v.play().catch(() => {});
      else v.pause();
      toggle.setAttribute('aria-label', joue ? toggle.dataset.pauseLabel! : toggle.dataset.playLabel!);
      iconPause.classList.toggle('hidden', !joue);
      iconPlay.classList.toggle('hidden', joue);
    };

    const montrer = (i: number) => {
      vids.forEach((v, k) => {
        const on = k === i;
        v.toggleAttribute('data-actif', on);
        v.setAttribute('aria-hidden', String(!on));
        tabs[k].setAttribute('aria-pressed', String(on));
        if (!on) {
          v.pause();
          v.currentTime = 0;
          bars[k].style.width = '0%';
        }
      });
      actif = i;
      sync();
    };

    vids.forEach((v, k) => {
      v.addEventListener('timeupdate', () => {
        if (v.duration) bars[k].style.width = `${(v.currentTime / v.duration) * 100}%`;
      });
      v.addEventListener('ended', () => montrer((k + 1) % vids.length));
    });

    tabs.forEach((t, k) =>
      t.addEventListener('click', () => {
        arrete = false;
        if (k !== actif) montrer(k);
        else sync();
      }),
    );

    toggle.addEventListener('click', () => {
      arrete = !arrete;
      sync();
    });

    // Rien ne tourne hors champ.
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        sync();
      },
      { threshold: 0.4 },
    ).observe(root);
  }
</script>
