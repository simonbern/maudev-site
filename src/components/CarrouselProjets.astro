---
import { Image } from 'astro:assets';
import CouvertureVideo from './CouvertureVideo.astro';
import type { CollectionEntry } from 'astro:content';
import CarrouselScript from './CarrouselScript.astro';
import { landing } from '../copy/landing';
import { localize, ui, type Locale } from '../i18n';
import { deliveryDate } from '../format';

/**
 * Carrousel horizontal des projets en location, sur l'accueil.
 *
 * Même mécanique que le carrousel de plans — `scroll-snap` natif, aucune
 * bibliothèque — mais un rôle différent : ici la vignette est une image de
 * projet plein cadre, et le survol la fait respirer.
 *
 * **La troisième carte doit être coupée par le cadre.** À 40 rem, deux cartes
 * remplissaient exactement la grille à 1 440 px : la piste ressemblait à deux
 * projets posés côte à côte, et rien ne disait qu'il y en avait un troisième.
 * À 30 rem, une tranche de la suivante dépasse toujours — c'est la seule chose
 * qui se lit comme « ça continue à droite » sans qu'on ait à l'écrire.
 *
 * Sur mobile la largeur est un pourcentage de la **piste**, pas du `vw` : à
 * 375 px, 86 vw valait 323 px pour une piste de 320 — la carte remplissait tout
 * le cadre et rien ne dépassait. La piste est à l'intérieur des marges de la
 * page, c'est donc elle la référence.
 *
 * **`grow` : les cartes se partagent la place quand il en reste.** Depuis le
 * retrait d'un projet il n'y en a plus que deux : à 1 440, deux cartes de
 * 480 px laissaient 192 px de vide à droite, ce qui se lit comme un projet
 * manquant et non comme une fin de liste. `flex-grow` ne distribue que l'espace
 * *libre* : dès que la piste déborde à nouveau, il ne fait plus rien et le
 * dépassement de la carte suivante revient tout seul. Le carrousel s'ajuste au
 * nombre de projets sans qu'on ait à le lui dire.

 *
 * Le mouvement au survol vit dans une couche interne, pas sur la carte : mettre
 * `scale` sur un lien déplace la zone cliquable pendant l'animation, et le
 * pointeur sort de l'élément qu'il vient d'agrandir.
 */
interface Props {
  projets: CollectionEntry<'projets'>[];
  locale: Locale;
}
const { projets, locale } = Astro.props;
const c = landing[locale].projets;
const u = ui[locale];
---

<div data-carrousel class="relative">
  {/* Pas de `tabindex` sur la piste. Un conteneur défilant focalisable
      déclenche `:focus-visible` **au toucher** dans Chrome — un anneau
      terracotta autour du carrousel entier dès qu'on y pose le doigt. Les
      cartes sont des liens : le clavier les atteint et le navigateur fait
      défiler la piste jusqu'à elles. */}
  <ul
    data-piste
    role="group"
    aria-label={c.title}
    class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 md:gap-8"
  >
    {
      projets.map((p, i) => {
        const d = p.data;
        const href = `${localize('/a-louer', locale)}/${d.url[locale]}`;
        return (
          <li class="w-[78%] max-w-[34rem] shrink-0 grow snap-start sm:w-[26rem] lg:w-[30rem] lg:max-w-none">
            <a href={href} class="group block cursor-pointer">
              <div class="relative aspect-[4/5] overflow-hidden bg-surface-alt sm:aspect-[4/3]">
                {d.couverture && (
                  <Image
                    src={d.couverture.src}
                    alt={d.couverture.alt[locale]}
                    widths={[600, 1000, 1400]}
                    sizes="(min-width: 1024px) 30rem, (min-width: 640px) 26rem, 78vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-doux)] group-hover:scale-[1.04]"
                  />
                )}
                {d.video?.carte && <CouvertureVideo src={d.video.carte} class="group-hover:scale-[1.04]" />}

                {/* Voile qui se lève au survol : le texte posé dessus reste
                    lisible au repos, et l'image reprend ses couleurs au
                    contact. */}
                <div
                  class="absolute inset-0 bg-gradient-to-t from-scrim/80 via-scrim/20 to-transparent transition-opacity duration-500 group-hover:opacity-70"
                  aria-hidden="true"
                />

                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-6 p-6 md:p-8">
                  <div>
                    <h3 class="text-h2 text-balance text-on-inverse">{d.nom}</h3>
                    <p class="mt-2 text-body text-on-inverse-muted">
                      {d.ville}
                      {d.livraison && ` · ${u.delivery} ${deliveryDate(d.livraison, locale)}`}
                    </p>
                  </div>

                  <span
                    class="rounded-card mb-1 hidden shrink-0 items-center justify-center p-3 text-on-inverse transition-all duration-500 ease-[var(--ease-doux)] group-hover:bg-accent group-hover:text-on-accent sm:inline-flex"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <div data-controles class="mt-8 flex items-center gap-4" hidden={projets.length < 2}>
    <span class="h-px flex-1 bg-line" aria-hidden="true">
      <span data-progression class="block h-px bg-accent transition-[width] duration-500"></span>
    </span>
    <div class="hidden items-center gap-2 md:flex">
      <button
        type="button"
        data-prec
        aria-label={c.precedent}
        class="rounded-card inline-flex h-12 w-12 cursor-pointer items-center justify-center border border-line text-ink transition-colors duration-200 hover:border-line-strong hover:bg-surface disabled:cursor-default disabled:opacity-35"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button
        type="button"
        data-suiv
        aria-label={c.suivant}
        class="rounded-card inline-flex h-12 w-12 cursor-pointer items-center justify-center border border-line text-ink transition-colors duration-200 hover:border-line-strong hover:bg-surface disabled:cursor-default disabled:opacity-35"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>
</div>

<CarrouselScript />
