---
import Panneau from './Panneau.astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Piliers from './Piliers.astro';
import { modele } from '../copy/modele';
import { localize, CONTACT, type Locale } from '../i18n';
// Rendu conservé d'un projet retiré du site. Il ne représente plus une fiche
// projet : c'est une image de marque, légendée comme un rendu et non comme une
// photo — le site distingue les deux partout ailleurs, il ne va pas commencer
// à les confondre ici.
import interieur from '../assets/marque/immeubles-boise.jpg';

/**
 * Corps de /notre-modele, partagé par les deux langues.
 *
 * Rythme des surfaces (DESIGN.md § 4) : page → inverse → surface-alt → page,
 * puis footer inverse. Jamais deux sections sombres de suite.
 *
 * Les respirations verticales sont volontairement inégales — l'ouverture est
 * la plus haute de la page, les raisons la plus serrée. Une page où chaque
 * section a la même hauteur se lit comme un gabarit rempli.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = modele[locale];

// Une icône par raison, dans l'ordre de la copie. Tableau plutôt que champ de
// contenu : ce sont des éléments de mise en page, pas de la donnée client.
const ICONES = ['hourglass', 'eye', 'layers', 'target'];

/**
 * Initiales, pour les membres dont on n'a pas encore la photo.
 *
 * Dérivées du nom, jamais saisies : un placeholder qu'il faut maintenir à la
 * main finit par contredire le nom qu'il accompagne. « Pierre-Hugues » n'a
 * qu'un mot dans la source — on prend alors les initiales de ses composantes.
 */
function initiales(nom: string): string {
  const mots = nom.split(' ').filter(Boolean);
  const source = mots.length > 1 ? [mots[0], mots.at(-1)!] : nom.split('-');
  return source
    .map((m) => m[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}

---

<!-- Ouverture. Titre à gauche, chapeau décalé à droite : le bloc centré
     titre + sous-titre est l'autre signature du gabarit. -->
<section class="bg-page pt-12 pb-4 md:pt-16 md:pb-6 lg:pt-20 lg:pb-8">
  <div class="mx-auto max-w-page px-5 md:px-8 lg:px-12">
    <div class="grid gap-y-8 md:grid-cols-12 md:gap-x-8">
      <h1 class="text-h1 text-balance text-ink md:col-span-7">{c.title}</h1>
      <p class="text-lead text-ink-soft md:col-span-5 md:col-start-8 md:self-end">{c.lead}</p>
    </div>
  </div>
</section>

<!-- Les trois métiers réunis sous un même toit.

     **Le rendu est à côté des trois métiers, pas au-dessus.** Deux mises en
     page ont été essayées puis retirées : un chevauchement sur la section
     précédente, puis un débordement jusqu'au bord droit de l'écran. Les deux
     faisaient flotter l'image à côté de la page. Une bande large et centrée
     l'a remplacée — propre, mais l'image y était seule sur sa ligne, un
     intervalle entre deux blocs de texte plutôt qu'un élément de la section.

     Ici elle occupe une colonne, les trois piliers l'autre : l'image accompagne
     ce qu'on lit au lieu de l'interrompre. En pile, les piliers deviennent
     assez hauts pour que l'image défile avec eux — d'où le `sticky`, qui la
     garde en vue tout le temps de la lecture. Sous `lg`, tout retombe en une
     colonne et le `sticky` ne s'applique plus : il n'y a plus rien à côté. -->
<section class="zone-claire bg-section-alt py-14 md:py-16 lg:py-20">
  <div class="mx-auto max-w-page px-5 md:px-8 lg:px-12">
    <h2 class="max-w-narrow text-h2 text-balance text-ink">{c.plateformeTitle}</h2>

    <div class="mt-10 grid gap-10 md:mt-12 lg:grid-cols-12 lg:gap-x-16">
      <figure class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <Image
          src={interieur}
          alt={c.imageAlt}
          widths={[600, 1000, 1400]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="lazy"
          class="aspect-[3/2] w-full object-cover lg:aspect-[4/5]"
        />
        <figcaption class="mt-4 text-small text-ink-muted">{c.imageLegende}</figcaption>
      </figure>

      <div class="lg:col-span-7">
        <Piliers piliers={c.piliers} />
      </div>
    </div>
  </div>
</section>

<!-- Quatre raisons. Ni numérotées, ni en grille de blocs égaux : la page porte
     déjà une liste numérotée juste au-dessus, et deux listes numérotées à
     quelques mètres l'une de l'autre, c'est le motif qui fait paraître une page
     automatiquement générée. Une première tentative en glossaire était juste
     mais terne : quatre lignes de texte gris, rien pour accrocher l'œil.

     Ici : un bandeau de quatre colonnes hautes, chacune ouverte par une icône
     de 56 px. Les filets supérieurs s'alignent et forment une seule ligne
     continue en tête de bande. L'icône donne à chaque argument une silhouette
     qu'on retient mieux qu'un intertitre.

     L'ordre des icônes suit l'ordre de la copie : elles sont indissociables des
     textes, mais restent décoratives — le titre porte l'information. -->
<section class="bg-page py-14 md:py-16 lg:py-20">
  <div class="mx-auto max-w-page px-5 md:px-8 lg:px-12">
    <h2 class="max-w-narrow text-h2 text-balance text-ink">{c.pourquoiTitle}</h2>

    {/* Chaque raison est un bloc posé sur la nuance de section, pas une
        colonne séparée par un filet. La section est pleine largeur ; ce sont
        ses composants qui sont contenus. */}
    <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-2 lg:grid-cols-4">
      {
        c.raisons.map((r, i) => (
          <li class="group carte-survol flex flex-col gap-5 rounded-panel bg-surface-alt p-7 md:p-8">
            <Icon
              name={ICONES[i] ?? 'dot'}
              stroke={1.75}
              class="icone-survol h-14 w-14 shrink-0 text-accent-ink"
            />
            <div>
              <h3 class="text-h3 text-balance text-ink">{r.titre}</h3>
              <p class="mt-3 text-body text-ink-soft">{r.texte}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Direction + contact. -->
<section class="zone-claire bg-section-alt py-12 md:py-14 lg:py-16">
  <div class="mx-auto max-w-page px-5 md:px-8 lg:px-12">
    <h2 class="max-w-narrow text-h2 text-balance text-ink">{c.equipeTitle}</h2>

    {/* Portraits ronds, nom, fonction. Le paragraphe qui nommait les six
        personnes à la file se lisait comme une énumération : on arrivait au
        bout sans retenir qui faisait quoi. Ici chaque personne a sa place, et
        la fonction tient en trois mots sous le nom.

        Les cercles sont la seule forme arrondie du site avec la puce de liste
        (§ 4) — un portrait rond n'est pas une boîte à coins adoucis, c'est un
        médaillon, et il se lit comme tel.

        **Aucune photo pour l'instant** : les initiales tiennent la place des
        six. Un aplat gris vide dirait « image manquante » ; les initiales
        disent « personne ». Dès qu'une photo arrive, elle remplace le cercle
        de son propriétaire — le reste de la grille ne bouge pas. */}
    <ul class="mt-10 grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 md:mt-14 lg:grid-cols-6 lg:gap-x-6">
      {
        c.equipe.map((m) => (
          <li class="flex flex-col items-center text-center">
            <span
              class="flex aspect-square w-28 items-center justify-center rounded-full bg-surface-alt text-h3 text-ink-muted md:w-32 lg:w-full lg:max-w-[10rem]"
              aria-hidden="true"
            >
              {initiales(m.nom)}
            </span>

            <p class="mt-5 text-body font-semibold text-balance text-ink">{m.nom}</p>
            <p class="mt-1 text-small text-balance text-ink-muted">{m.role}</p>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-20 flex flex-col items-start justify-between gap-8 border-t border-line-strong pt-12 md:mt-28 md:flex-row md:items-end"
    >
      <div>
        <h2 class="text-h2 text-balance text-ink">{c.ctaTitle}</h2>
        <p class="mt-3 text-lead text-ink-muted">{c.ctaLead}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={localize('/projets', locale)}
          class="inline-flex h-12 cursor-pointer items-center rounded-card border border-line-strong px-6 text-small font-semibold text-ink transition-colors duration-200 hover:bg-surface-hover"
        >
          {c.ctaProjets}
        </a>
        <a
          href={`mailto:${CONTACT.email}`}
          class="inline-flex h-12 shrink-0 cursor-pointer items-center rounded-card bg-accent px-6 text-small font-semibold text-on-accent transition-colors duration-200 hover:bg-accent-hover"
        >
          {c.ctaBouton}
        </a>
      </div>
    </div>
  </div>
</section>
